-- ============================================================
--  F.L.E.X VAPE SHOP — PostgreSQL Database Setup
--  Run this in pgAdmin Query Tool
--  Step 1: Connect to your PostgreSQL server in pgAdmin
--  Step 2: Open Query Tool (Tools > Query Tool)
--  Step 3: Paste and run this entire script
-- ============================================================


-- ------------------------------------------------------------
-- 1. CREATE DATABASE
--    (Run this block alone first, then reconnect to flex_vape_db)
-- ------------------------------------------------------------
CREATE DATABASE flex_vape_db
    WITH
    OWNER = postgres
    ENCODING = 'UTF8'
    LC_COLLATE = 'en_US.UTF-8'
    LC_CTYPE = 'en_US.UTF-8'
    TEMPLATE = template0
    CONNECTION LIMIT = -1;

COMMENT ON DATABASE flex_vape_db IS 'F.L.E.X Vape Shop Inventory Management Database';


-- ============================================================
-- CONNECT TO flex_vape_db BEFORE RUNNING EVERYTHING BELOW
-- In pgAdmin: right-click flex_vape_db > Query Tool
-- ============================================================


-- ------------------------------------------------------------
-- 2. CREATE TABLES
-- ------------------------------------------------------------

-- Products table
CREATE TABLE IF NOT EXISTS product (
    id          SERIAL PRIMARY KEY,
    barcode     VARCHAR(50) UNIQUE,
    code_name   VARCHAR(50),
    name        VARCHAR(100) NOT NULL,
    flavor      VARCHAR(100),
    type        VARCHAR(50),
    version     VARCHAR(50),
    mg          VARCHAR(20),
    qty         INTEGER DEFAULT 0,
    cost        DOUBLE PRECISION DEFAULT 0.0,
    price       DOUBLE PRECISION DEFAULT 0.0,
    discount    DOUBLE PRECISION DEFAULT 0.0,
    image       VARCHAR(255) DEFAULT 'default.jpg',
    date_added  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Stock In Log (purchases / restocks)
CREATE TABLE IF NOT EXISTS stock_in_log (
    id          SERIAL PRIMARY KEY,
    date        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    name        VARCHAR(100),
    flavor      VARCHAR(100),
    category    VARCHAR(50),
    qty         INTEGER
);

-- Stock Out Log (sales)
CREATE TABLE IF NOT EXISTS stock_out_log (
    id          SERIAL PRIMARY KEY,
    date        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    name        VARCHAR(100),
    flavor      VARCHAR(100),
    category    VARCHAR(50),
    qty         INTEGER,
    price       DOUBLE PRECISION DEFAULT 0.0,
    cost        DOUBLE PRECISION DEFAULT 0.0
);

-- Purchase Orders (saved orders from Purchase Report page)
CREATE TABLE IF NOT EXISTS purchase_order (
    id             SERIAL PRIMARY KEY,
    po_number      VARCHAR(30) UNIQUE NOT NULL,
    date_created   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    date_confirmed TIMESTAMP,
    status         VARCHAR(20) DEFAULT 'pending',   -- 'pending' | 'confirmed'
    notes          VARCHAR(255)
);

-- Purchase Order Items (line items linked to each purchase order)
CREATE TABLE IF NOT EXISTS purchase_order_item (
    id           SERIAL PRIMARY KEY,
    po_id        INTEGER NOT NULL REFERENCES purchase_order(id) ON DELETE CASCADE,
    product_id   INTEGER,
    name         VARCHAR(100) NOT NULL,
    flavor       VARCHAR(100),
    category     VARCHAR(50),
    ordered_qty  INTEGER DEFAULT 0,
    received_qty INTEGER,                           -- filled when order is confirmed
    unit_cost    DOUBLE PRECISION DEFAULT 0.0
);


-- ------------------------------------------------------------
-- 3. INDEXES (for faster dashboard queries)
-- ------------------------------------------------------------

-- Speed up date-range sales queries
CREATE INDEX IF NOT EXISTS idx_stock_out_date    ON stock_out_log    (date);
CREATE INDEX IF NOT EXISTS idx_stock_in_date     ON stock_in_log     (date);

-- Speed up low-stock lookups
CREATE INDEX IF NOT EXISTS idx_product_qty       ON product          (qty);

-- Speed up barcode scans
CREATE INDEX IF NOT EXISTS idx_product_barcode   ON product          (barcode);

-- Speed up name-based grouping on reports
CREATE INDEX IF NOT EXISTS idx_stock_out_name    ON stock_out_log    (name);
CREATE INDEX IF NOT EXISTS idx_stock_in_name     ON stock_in_log     (name);

-- Speed up purchase order lookups
CREATE INDEX IF NOT EXISTS idx_po_status         ON purchase_order   (status);
CREATE INDEX IF NOT EXISTS idx_po_item_po_id     ON purchase_order_item (po_id);


